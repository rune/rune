{
  "name": "rune-mcp",
  "version": "0.0.1",
  "description": "Model Context Protocol (MCP) Server for creating multiplayer mobile games with Rune SDK",
  "license": "MIT",
  "keywords": [
    "rune",
    "model-context-protocol",
    "mcp",
    "game",
    "sdk",
    "multiplayer",
    "mobile"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rune/rune.git",
    "directory": "packages/rune-mcp"
  },
  "author": "Rune AI Inc",
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "prepublishOnly": "yarn build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "exit 0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.10.2",
    "open": "10.1.1",
    "zod": "3.24.3",
    "rune": "7.9.2",
    "adm-zip": "0.5.9"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "typescript": "5.8.3"
  }
}
