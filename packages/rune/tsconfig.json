{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "jsx": "react",
    "types": ["node"],
    "outDir": "dist",
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "**/*-test.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/lib/jscodeshift/**/__testfixtures__/**/*"
  ]
}
